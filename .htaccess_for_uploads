# Force PDF downloads instead of opening in browser
# Place this file in: /wp-content/uploads/
# Rename to: .htaccess

<FilesMatch "\.pdf$">
    Header set Content-Disposition "attachment"
    Header set X-Content-Type-Options "nosniff"
</FilesMatch>

